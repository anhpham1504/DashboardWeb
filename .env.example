# MySQL connection. Create a least-privilege application user; never commit the real value.
DATABASE_URL="mysql://fpt_dashboard_app:change-me@127.0.0.1:3306/fpt_dashboard"

# Public and trusted browser origins. APP_ORIGINS accepts a comma-separated list.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
APP_ORIGINS="http://localhost:3000"

# Server-side session and login protection.
SESSION_HOURS="8"
LOGIN_WINDOW_MINUTES="15"
LOGIN_IP_LIMIT="50"
LOGIN_ACCOUNT_LIMIT="10"
LOGIN_LOCK_THRESHOLD="5"
LOGIN_LOCK_MINUTES="15"
TRUST_PROXY="false"

# Use "url" unless the deployment has a persistent disk. "local" stores WebP files in public/uploads.
STORAGE_DRIVER="url"
MAX_UPLOAD_MB="5"

# One-time SQLite import and first-admin CLI inputs.
SQLITE_SOURCE="prisma/dev.db"
ADMIN_USERNAME="admin"
ADMIN_NAME="Quản trị viên"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
